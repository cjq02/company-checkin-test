.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-name {
  font-size: 32rpx;
  font-weight: 600;
}

.record-badge {
  font-size: 22rpx;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.record-line {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.8;
}
