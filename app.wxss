page {
  background: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2329;
}

button::after {
  border: none;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  padding: 24rpx 8rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a73e8;
}

.subtitle {
  font-size: 26rpx;
  color: #8a9099;
  margin-top: 12rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a73e8;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
  font-size: 28rpx;
}

.info-row .k {
  width: 150rpx;
  flex-shrink: 0;
  color: #8a9099;
}

.info-row .v {
  flex: 1;
  color: #1f2329;
  word-break: break-all;
}

.status {
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  margin: 20rpx 0;
}

.status.ok {
  background: #e8f5e9;
  color: #2e7d32;
}

.status.warn {
  background: #fff3e0;
  color: #ef6c00;
}

.hint {
  font-size: 24rpx;
  color: #9aa0a6;
  text-align: center;
  margin-top: 16rpx;
}

.empty {
  font-size: 28rpx;
  color: #9aa0a6;
  text-align: center;
  padding: 40rpx 0;
}

.primary-btn,
.ghost-btn,
.danger-btn,
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0;
  line-height: normal;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  margin-top: 16rpx;
}

.primary-btn {
  background: #1a73e8;
  color: #fff;
}

.ghost-btn {
  background: #fff;
  color: #1a73e8;
  border: 1rpx solid #1a73e8;
  box-sizing: border-box;
}

.danger-btn {
  background: #fff;
  color: #e53935;
  border: 1rpx solid #e53935;
  box-sizing: border-box;
}

.logout-btn {
  background: transparent;
  color: #8a9099;
  font-size: 28rpx;
  margin-top: 32rpx;
}

button[disabled] {
  opacity: 0.5;
}

.role-switch {
  display: flex;
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.role-item {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 10rpx;
}

.role-item.active {
  background: #fff;
  color: #1a73e8;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.clock-card {
  background: linear-gradient(135deg, #1a73e8, #4a90ff);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}

.clock-time {
  font-size: 96rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
}

.clock-date {
  font-size: 28rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}
